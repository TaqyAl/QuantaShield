root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{js,css,html,json,yml,yaml,fst}]
indent_size = 2

# Preserve Markdown's intentional two-space hard line breaks.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = tab

[*.{bat,cmd}]
end_of_line = crlf
